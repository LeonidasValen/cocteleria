{
  "rewrites": [
    {
      "source": "/auth/(.*)", 
      "destination": "/api/auth/$1"
    },
    {
      "source": "/user/(.*)", 
      "destination": "/api/user/$1"
    },
    {
      "source": "/coctel/(.*)", 
      "destination": "/api/coctel/$1"
    },
    {
      "source": "/(.*)", 
      "destination": "/index.html"
    }
  ]
