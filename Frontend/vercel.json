{
  "rewrites": [
    {
      "source": "/auth/(.*)", 
      "destination": "/auth/$1"
    },
    {
      "source": "/user/(.*)", 
      "destination": "/user/$1"
    },
    {
      "source": "/coctel/(.*)", 
      "destination": "/coctel/$1"
    },
    {
      "source": "/(.*)", 
      "destination": "/index.html"
    }
  ]
}
