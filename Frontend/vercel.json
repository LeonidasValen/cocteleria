{
  "redirects": [
    {
      "source": "/auth/(.*)",
      "destination": "https://cocteleria-back.vercel.app/auth/$1"
    },
    {
      "source": "/user/(.*)",
      "destination": "https://cocteleria-back.vercel.app/user/$1"
    },
    {
      "source": "/coctel/(.*)",
      "destination": "https://cocteleria-back.vercel.app/coctel/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
